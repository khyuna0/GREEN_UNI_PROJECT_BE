// 에러 처리 (실무 패턴)
private Mono<CounselingResponse> handleError(String aiProvider, Throwable e) {
    log.error("{} API 호출 실패", aiProvider, e);

    // 기본 응답 반환
    CounselingResponse fallback = new CounselingResponse();
    fallback.setReason("AI 분석 중 오류가 발생했습니다.");
    fallback.setCounselingScript("학생과의 면담이 필요합니다. 직접 상담을 권장합니다.");

    return Mono.just(fallback);
}

// JSON 문자열 이스케이프 (따옴표 처리)
private String escapeJson(String text) {
    return text.replace("\"", "\\\"")
            .replace("\n", "\\n")
            .replace("\r", "");
}

}
