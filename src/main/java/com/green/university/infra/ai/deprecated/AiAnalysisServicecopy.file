import org.springframework.beans.factory.annotation.Value;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;
import org.springframework.web.reactive.function.client.WebClient;
import tools.jackson.databind.JsonNode;
import tools.jackson.databind.ObjectMapper;

import java.util.HashMap;
import java.util.List;
import java.util.Map;

@Service
@Slf4j
@RequiredArgsConstructor
public class AiAnalysisServicecopy {

    private final WebClient geminiWebClient;
    private final WebClient mistralWebClient;
    private final ObjectMapper objectMapper;
    private final DropoutRiskRepository dropoutRiskRepository;

    @Value("${app.ai.mistral.model}")
    private String mistralModel;

    // ========== 공통 상담 프롬프트 템플릿 ==========
    private static final String COUNSELING_PROMPT_TEMPLATE = """
                당신은 대학교의 20년 이상 경력의 상담 심리학자입니다.
                학생의 중도 이탈을 막기 위해 교수가 학생에게 건넬 따뜻하고 효과적인 상담 멘트와 분석을 제공하세요.

                분석 대상 학생 정보:
                - 이름: %s
                - 학과: %s
                - 위험 유형: %s
                - 위험 수준: %s
                - 과목명: %s
                - 상세 정보: %s

                위 정보를 바탕으로 학생에 대한 중도 이탈 위험 분석을 진행해주세요.
                JSON 형태로 응답 결과를 반환해주세요.
                1. reason: 학생이 겪고 있을 것으로 추정되는 어려움 (한 줄 요약)
                2. counseling_script: 교수가 학생에게 보낼 상담 메시지 (권위적이지 않고 걱정하는 투로, 200자 이내)
                3. student_action: 학생에게 권장할 구체적인 행동 (예: "학습 상담센터 방문", 150자 이내)

                반드시 순수 JSON만 반환하세요. 마크다운 코드블록(```
                {"reason":"...", "counseling_script":"...", "student_action":"..."}
                """;

    public AiService(
            @Qualifier("geminiWebClient") WebClient geminiWebClient,
            @Qualifier("mistralWebClient") WebClient mistralWebClient,
            ObjectMapper objectMapper,
            DropoutRiskRepository dropoutRiskRepository) {
        this.geminiWebClient = geminiWebClient;
        this.mistralWebClient = mistralWebClient;
        this.objectMapper = objectMapper;
        this.dropoutRiskRepository = dropoutRiskRepository;
    }


    // ========== Gemini로 분석 + DB 저장 + 알림 DTO 반환 ==========
    @Transactional
    public String callGeminiApi(Student student, Subject subject, String reason) {

            String prompt = buildPrompt(student, subject, reason);

            Map<String, Object> requestBody = new HashMap<>();
            requestBody.put("contents", List.of(
                    Map.of("parts", List.of(
                            Map.of("text", prompt)
                    ))
            ));

            WebClient webClient = webClientBuilder
                    .baseUrl(aiProperties.getGemini().getUrl())
                    .defaultHeader("Content-Type", "application/json")
                    .build();

            String response = webClient.post()
                    .uri(uriBuilder -> uriBuilder
                            .queryParam("key", aiProperties.getGemini().getApiKey())
                            .build())
                    .bodyValue(requestBody)
                    .retrieve()
                    .bodyToMono(String.class)
                    .block();

            return parseGeminiResponse(response);
        }

        private String parseGeminiResponse(String jsonResponse) {
            try {
                JsonNode root = objectMapper.readTree(jsonResponse);
                return root.path("candidates")
                        .get(0)
                        .path("content")
                        .path("parts")
                        .get(0)
                        .path("text")
                        .asText();
            } catch (Exception e) {
                log.error("Gemini 응답 파싱 실패: {}", e.getMessage());
                return "[AI 분석 불가] 일시적인 오류가 발생했습니다.";
            }
        }

        // ========== Mistral API 호출 ==========
    @Transactional
        public String callMistralApi(Student student, Subject subject, String reason) {

            String prompt = buildPrompt(student, subject, reason);

            Map<String, Object> requestBody = new HashMap<>();
            requestBody.put("model", "mistral-small-latest");
            requestBody.put("messages", List.of(
                    Map.of("role", "system", "content", "당신은 대학교의 학생 상담 전문가입니다."),
                    Map.of("role", "user", "content", prompt)
            ));

            WebClient webClient = webClientBuilder
                    .baseUrl(aiProperties.getMistral().getUrl())
                    .defaultHeader("Content-Type", "application/json")
                    .defaultHeader("Authorization", "Bearer " + aiProperties.getMistral().getApiKey())
                    .build();

            String response = webClient.post()
                    .bodyValue(requestBody)
                    .retrieve()
                    .bodyToMono(String.class)
                    .block();

            return parseMistralResponse(response);
        }

        private String parseMistralResponse(String jsonResponse) {
            try {
                JsonNode root = objectMapper.readTree(jsonResponse);
                return root.path("choices")
                        .get(0)
                        .path("message")
                        .path("content")
                        .asText();
            } catch (Exception e) {
                log.error("Mistral 응답 파싱 실패: {}", e.getMessage());
                return "[AI 분석 불가] 일시적인 오류가 발생했습니다.";
            }
        }



    // ========== AI 실패 시 기본 메시지 ==========
